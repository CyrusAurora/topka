# Topka configuration. Copy to .env and edit (or run `node scripts/init-env.ts`, which generates .env
# with random secrets and an admin password). The front end only learns the site URL; every secret stays
# on the backend. Never commit .env.

# ===== Required =====

# Site address used for generated links, RSS, share images and MCP. [required]
SITE_URL=http://localhost:3000

# Interface language for visitors and the admin: zh-CN (default) or en. Signed-in readers pick their own
# in Settings. Content (titles, summaries) stays in the site's content language.
# SITE_LOCALE=zh-CN

# Admin password for /admin, at least 12 characters. [required in production]
ADMIN_PASSWORD=

# Session signing secret and image-proxy signing secret: one random string each
# (`openssl rand -hex 32`). [required]
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
# Reader session cookie name; set it to keep an existing deployment's cookie when upgrading.
# SESSION_COOKIE_NAME=topka_session

# Database password when using Docker Compose (the database port is not published). [required with Docker]
POSTGRES_PASSWORD=

# Any OpenAI-compatible chat API works; every step uses it unless a preset below is selected.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Provider-specific request fields (JSON), e.g. turning reasoning off for short structured tasks:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

# ===== Site and network =====

# Public HTTPS domain when using `docker compose --profile https`.
# SITE_DOMAIN=example.com
# API and web listen addresses (compose sets the hosts to 0.0.0.0).
# API_HOST=127.0.0.1
# API_PORT=3001
# WEB_HOST=127.0.0.1
# WEB_PORT=3000
# docker compose: where the web container is published on the host. Default 127.0.0.1:3000 (this machine
# only). PORT=3000 opens it on every interface over plain HTTP: prefer the https profile on a server.
# Without Docker: fallback web port when WEB_PORT is unset.
# PORT=127.0.0.1:3000
# Where the web server reaches the API (compose sets http://api:3001).
# API_BASE_URL=http://127.0.0.1:3001
# Where local image rendering reaches the web server.
# LOCAL_ROUTER_URL=http://127.0.0.1:3000
# Set true behind Caddy/Nginx so the client address comes from X-Forwarded-For.
TRUST_PROXY=false
# Extra Host values MCP accepts (comma-separated); SITE_URL host and localhost are always allowed.
# MCP_ALLOWED_HOSTS=
# Log level (fatal|error|warn|info|debug|trace|silent).
# LOG_LEVEL=info
# Release label in health output and heartbeats.
# TOPKA_RELEASE=dev

# ===== Database =====

# Non-Docker default; compose overrides it with the `db` service.
# DATABASE_URL=postgres://topka@127.0.0.1:5432/topka
# DATABASE_POOL_MAX=10
# Directory of model/collector assets and exported snapshots.
# TOPKA_DATA_DIR=.data
# Optional directory of per-group dotenv files (models.env, collectors.env, integrations.env, auth.env).
# TOPKA_CREDENTIALS_DIR=

# ===== Models: default and presets =====

# Vision input for selected items (the first image informs title and summary).
# LLM_VISION=true
# Set false when the provider does not support response_format=json_object.
# LLM_JSON_MODE=false
# OpenRouter attribution headers.
# LLM_APP_URL=
# LLM_APP_TITLE=Topka

# Free-only background chain: providers join in this order, only when configured.
# LLM_PROVIDER_ORDER=opencode,agnes,openrouter
# Free OpenRouter candidates, checked for zero price before every use (LLM_MODEL is then unused).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_FREE_MODELS=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Optional override for the price catalog and the quota endpoint.
# LLM_FREE_CATALOG_URL=
# LLM_FREE_QUOTA_URL=
# Calls kept back from background work each UTC day (20) and for interactive chat (30).
# LLM_FREE_DAILY_RESERVE=20
# LLM_INTERACTIVE_RESERVE=30

# OpenCode Zen (free list only: zero price on models.dev, never big-pickle/nemotron).
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_EXTRA_JSON=
# OPENCODE_FREE_ORDER=deepseek,glm,mimo,minimax,beam,longcat
# OPENCODE_MODELS_URL=https://opencode.ai/zen/v1/models
# OPENCODE_DOCS_URL=https://opencode.ai/v2/docs/console/models/
# Free models answer only through OpenCode itself: cli runs `opencode run` per call, acting tools denied.
# OPENCODE_TRANSPORT=cli
# OPENCODE_BIN=opencode
# OPENCODE_ALLOW=deepseek-v4.1-flash-free,glm-5.3-flash-free
# OPENCODE_CLI_CONCURRENCY=2
# OPENCODE_CLI_TIMEOUT_MS=45000
# OPENCODE_CLI_REST_SECONDS=600
# OPENCODE_CLI_PRUNE_HOURS=6
# OPENCODE_CLI_HOME=
# MODELS_DEV_URL=https://models.dev/api.json

# Agnes (agnes-3.0-flash); a billing/quota refusal benches it until 08:00 UTC+8.
# AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash
# AGNES_EXTRA_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# Named presets: each needs its own base URL and key.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_API_KEY=
# XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# XIAOMI_MIMO_API_KEY=

# ===== Models: per-step overrides =====

# Preset name per step (default: the LLM_* model above). A named preset bypasses the free guard and
# is billed by its provider.
# PREFILTER_MODEL=
# SCORE_MODEL=
# UNDERSTAND_MODEL=
# SUMMARIZE_MODEL=
# STRUCTURE_MODEL=
# GROUP_MODEL=
# GROUP_REVIEW_MODEL=
# DIGEST_MODEL=
# REPORT_MODEL=
# TRANSLATE_MODEL=
# CARD_MODEL=
# ASSISTANT_MODEL=
# MONITOR_MODEL=

# ===== Embeddings (optional; grouping works without them) =====

# Any OpenAI-compatible /embeddings endpoint.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=0
# Or fill only a DashScope key to use text-embedding-v4.
# DASHSCOPE_API_KEY=
# Free-only SiliconFlow candidates (same dimension); checked against the public price list before use.
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_FREE_MODELS=BAAI/bge-m3,BAAI/bge-large-zh-v1.5
# EMBEDDING_FREE_DIMS=1024
# EMBEDDING_FREE_PRICING_URL=https://siliconflow.cn/pricing
# Set false to disable embeddings even when a key is present.
# EMBEDDINGS_ENABLED=true

# ===== Collection and processing =====

# Safety valves. New deployments start with both off; turn them on after sources and models are ready.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
# true: docker compose's first run also loads invented demo content (a demo@example.com reader with
# three days of example stories, see docs/tutorial.md). Nothing is fetched and no model is called.
DEMO_SEED=false
# Password for the demo reader; unset means a random one, printed once by the setup service.
# DEMO_PASSWORD=
# Source kinds scheduled by the worker.
# COLLECT_KINDS=rss,web_list,json_list,x_search
# Skip the Jina Reader fallback when a page has no extractable body.
# COLLECT_SKIP_JINA=false
# JINA_BODY_FALLBACK=false
# Concurrency limits.
# FETCH_CONCURRENCY=8
# FETCH_SCHEDULE_BATCH=40
# ANALYZE_CONCURRENCY=6
# SEARCH_MAX_CONCURRENCY=4
# SEARCH_MAX_QUEUE=8
# Selected items become visible after this many seconds.
# SELECTED_VISIBLE_AFTER_SECONDS=180
# Alert when no new content arrived for this many minutes.
# ALERT_QUIET_MINUTES=360

# ===== History analysis =====

# History no reader view shows (backfill published >24h ago) is analysed last.
# defer (default): only inside the evening window, while more than the reserve is left today.
# skip: never analysed (marked skipped). on: no gate.
# HISTORY_ANALYSIS=defer
# HISTORY_ANALYSIS_WINDOW=20-8
# Time zone of the window; default Asia/Shanghai (UTC+8).
# HISTORY_ANALYSIS_TZ=Asia/Shanghai
# HISTORY_ANALYSIS_RESERVE=150
# Anything published more than this many hours ago is skipped without a model call (0 = off).
# STALE_ANALYSIS_HOURS=72

# ===== Today view =====

# Cards per project (3–5, default 3), ordered by project score, one per event.
# TODAY_CARD_COUNT=3
# Hero layout: exactly three items and the first leads the second by this many points.
# ISSUE_HERO_LEAD=10
# Model turns per user per UTC day for 对话.
# ASSISTANT_DAILY_TURNS=40
# Chat messages per user per minute (0 = no burst guard).
# CHAT_PER_MINUTE=8

# ===== Paid collectors (each has its own budget circuit breaker in the admin) =====

# X/Twitter accounts through SocialData.
# SOCIALDATA_API_KEY=
# SOCIALDATA_BASE_URL=https://api.socialdata.tools
# WeChat official-account posts through Dajiala.
# DAJIALA_KEY=
# DAJIALA_BASE_URL=https://www.dajiala.com
# Browser-rendered fallback for pages without extractable text (Jina Reader).
# JINA_API_KEY=
# JINA_BASE_URL=https://r.jina.ai
# Higher GitHub API quota (read-only token).
# GITHUB_TOKEN=
# Artificial Analysis leaderboard source.
# ARTIFICIAL_ANALYSIS_API_KEY=
# Proxy for fetching overseas sources from mainland China.
# EGRESS_PROXY_URL=http://127.0.0.1:7890

# ===== Feishu notifications (optional) =====

# Push selected content to group webhooks; enable the target in the admin.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alerts and feedback forwarding through a Feishu app.
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Sign in to the admin with a Feishu account (alongside the admin password).
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Security and operations =====

# Registration: open (default — anyone may sign up; readers bring their own model key) or invite
# (a code from `npm run invite:create` is required). Anything else counts as invite.
# REGISTRATION_MODE=open
# Successful sign-ups allowed per hour across the whole instance (abuse brake; per client it is 5).
# REGISTRATION_HOURLY_LIMIT=30
# Sign-in lockout per email address (on top of the per-client limit): after THRESHOLD attempts in
# WINDOW seconds the address is locked for BASE seconds, doubling each time up to MAX. Same answer
# whether or not the address has an account.
# LOGIN_LOCK_THRESHOLD=5
# LOGIN_LOCK_WINDOW_SECONDS=900
# LOGIN_LOCK_BASE_SECONDS=60
# LOGIN_LOCK_MAX_SECONDS=3600
# Development only: allow a BYOK Base URL on loopback/private addresses (SSRF guard off). Never in prod.
# BYOK_ALLOW_PRIVATE_BASE_URL=false

# Per-user model keys (BYOK): a random secret 32+ characters long. scripts/init-env.ts fills it;
# by hand: `openssl rand -hex 32`. Empty turns BYOK off; keys are stored AES-256-GCM encrypted.
KEY_ENCRYPTION_SECRET=
# Token for POST /api/ingest/items, at least 16 characters; empty closes the endpoint.
# INGEST_TOKEN=
# Require the signature on proxied images (default true).
# IMG_PROXY_REQUIRE_SIG=true
# Submit new pages to IndexNow daily; key is 32 hex characters.
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Daily database backup to an S3-compatible bucket.
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=

# ===== Plugins =====

# Comma-separated module paths (relative to the process working directory, or absolute). Each module's
# default export (or register()) runs once when the API, worker or a chat-capable script starts.
# Unset means no plugins.
# TOPKA_PLUGINS=./plugins/example.ts

# ===== Development and tests only =====

# Bypass login in development; production refuses to start with any DEV_AUTH_* variable set.
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Allow fetches to private network addresses (tests use this; never in production).
# ALLOW_PRIVATE_NETWORK_FETCH=false
# NODE_ENV=development
# Name this deployment in alerts ("production" sends them without a prefix).
# TOPKA_ENVIRONMENT=development
# Path to the changelog JSON used by the about page.
# TOPKA_CHANGELOG_FILE=industry/changelog.json
# Rows compared by the leaderboard fetch check script.
# SHOW=12
